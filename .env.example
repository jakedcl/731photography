NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-06

# Server-only — create in sanity.io/manage → API → Tokens
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Site URL (used for Stripe redirect URLs)
# NEXT_PUBLIC_SITE_URL=https://thomaslurker.com

# Resend — event inquiry + order emails
RESEND_API_KEY=
# Optional override; otherwise uses Site settings → inquiry email in Sanity
EVENT_INQUIRY_TO_EMAIL=
# Optional. Defaults to Resend onboarding sender until your domain is verified.
# Needed for customer order emails (not just the inquiry inbox).
# RESEND_FROM_EMAIL=Thomas Lurker <hello@thomaslurker.com>

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From Stripe Dashboard → Developers → Webhooks (or stripe listen --forward-to)
STRIPE_WEBHOOK_SECRET=

# Prodigi print-on-demand
PRODIGI_API_KEY=
# sandbox (default) or live
PRODIGI_ENV=sandbox
# Budget | Standard | Express | etc.
# PRODIGI_SHIPPING_METHOD=Standard
# Optional shared token appended to callback URL (?token=…)
# PRODIGI_WEBHOOK_SECRET=